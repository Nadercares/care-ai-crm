# Copy to .env and fill in. .env is gitignored — keys never get committed.

# CARE AI CRM backend (Supabase) — used by execution scripts
SUPABASE_URL=              # e.g. https://<project-ref>.supabase.co or http://127.0.0.1:54321 for local
SUPABASE_SERVICE_ROLE_KEY= # service role key (server-side only, never expose to a browser)

# Optional integrations (scripts degrade gracefully without them)
ANTHROPIC_API_KEY=         # only needed if a script calls Claude directly outside a session
SLACK_WEBHOOK_URL=         # for done-notifications, if/when Phase 9 is added
