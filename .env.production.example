# CARE AI CRM — production frontend environment (Roadmap Stage 13)
#
# These are the environment variables the WEBSITE needs. In production you set
# them in the Railway dashboard (Variables tab), not in this file. This file is
# only a reference for which variables to set. See CARE_DEPLOYMENT.md.
#
# Every value here is safe to expose in the browser — there are NO secret keys.
# The Anthropic and Mapbox keys live only in Supabase (set with
# `npx supabase secrets set ...`), never here.

# Your production Supabase project URL (Supabase dashboard -> Project Settings -> API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase publishable (anon) key — this key is public by design.
VITE_SB_PUBLISHABLE_KEY=your-supabase-publishable-key

# Must be false for the real backend (true would use the in-browser demo data).
VITE_IS_DEMO=false

# The inbound email address used for email capture (from your Postmark setup).
VITE_INBOUND_EMAIL=your-inbound-address@inbound.postmarkapp.com

# The Supabase Storage bucket for uploaded files (policy PDFs, attachments).
VITE_ATTACHMENTS_BUCKET=attachments
