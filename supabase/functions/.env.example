# =====================================================================
# CARE AI CRM — Supabase function secrets
#
# Copy to supabase/functions/.env (gitignored) for local dev, OR set
# on the Supabase project with:
#   npx supabase secrets set KEY=VALUE
#   npx supabase secrets set --env-file supabase/functions/.env
#
# Phase numbers reference doc/DEPLOYMENT_AND_REMOTE_ACCESS.md.
# =====================================================================

# --- Anthropic (Phase 5/6/7/13/14/16, required for ALL AI features) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional per-feature model overrides (defaults to claude-sonnet-4-6
# which is set via ANTHROPIC_MODEL):
ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_CHAT_MODEL=
# ANTHROPIC_BRIEFING_MODEL=
# ANTHROPIC_TRIAGE_MODEL=
# ANTHROPIC_DRAFT_MODEL=
# ANTHROPIC_COMPARE_MODEL=
# ANTHROPIC_CALENDAR_MODEL=
# ANTHROPIC_DROPBOX_MODEL=

# --- Google OAuth (Phase 9: Gmail / Phase 10: Calendar) ---
# Required for gmail-oauth-callback, gmail-triage, draft-email-reply,
# schedule-inspection, calendar-sync, daily-briefing (when saving to
# Gmail drafts).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must EXACTLY match the redirect URI registered in Google Cloud:
GMAIL_OAUTH_REDIRECT_URI=https://<your-project-ref>.supabase.co/functions/v1/gmail-oauth-callback
# Where staff is bounced after consent (your CRM's public URL):
APP_URL=https://crm.careai.example

# --- Dropbox OAuth (Phase 11) ---
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_OAUTH_REDIRECT_URI=https://<your-project-ref>.supabase.co/functions/v1/dropbox-oauth-callback

# --- HailTrace storm verification API (Phase 14, optional) ---
# Email developers@hailtrace.com for API credentials. Until set,
# the Verify-with-HailTrace button returns a clear 503 and Manual
# storm-verification entry still works.
HAILTRACE_API_KEY=
HAILTRACE_API_BASE=https://fa7c838b-developers.hailtrace.com/api/external
HAILTRACE_VERIFY_PATH=
# Header name carrying the key (defaults to x-api-key):
# HAILTRACE_AUTH_HEADER=x-api-key

# --- Cron (Phase 9b/13/16) ---
# Shared secret used by gmail-triage-runner, daily-briefing-runner,
# and calendar-sync-runner. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# --- Postmark inbound email (existing Atomic CRM feature, optional) ---
POSTMARK_WEBHOOK_USER=testuser
POSTMARK_WEBHOOK_PASSWORD=testpwd
POSTMARK_WEBHOOK_AUTHORIZED_IPS=3.134.147.250,50.31.156.6,50.31.156.77,18.217.206.57,172.18.0.1,172.19.0.1,192.168.65.1,172.20.0.1
VITE_INBOUND_EMAIL=replace-with-postmark-inbound@inbound.postmarkapp.com

# --- Supabase platform vars (auto-injected on deployed functions;
# only set locally) ---
SB_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SB_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY are
# provided automatically when deployed; for local dev they come from
# `npx supabase start` output.
