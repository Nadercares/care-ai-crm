# =====================================================================
# CARE AI CRM — frontend env
#
# Copy to .env.development (local) or set on your hosting platform
# (Railway, Vercel, etc.) for prod. Anything beginning with VITE_
# IS exposed in the browser bundle — keep secrets out.
#
# Phase numbers reference doc/DEPLOYMENT_AND_REMOTE_ACCESS.md.
# =====================================================================

# --- Supabase (Phase 7, required for everything) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SB_PUBLISHABLE_KEY=sb_publishable_...

# --- App identity ---
VITE_IS_DEMO=false
VITE_ATTACHMENTS_BUCKET=attachments

# --- Inbound email via Postmark (optional) ---
VITE_INBOUND_EMAIL=replace-with-postmark-inbound-address@inbound.postmarkapp.com

# --- Gmail / Google Calendar OAuth (Phase 9 / 10, optional) ---
# Publishable client ID — the secret stays server-side.
# Get from console.cloud.google.com → APIs & Services → Credentials.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# --- Dropbox OAuth (Phase 11, optional) ---
# App key from dropbox.com/developers/apps. App secret stays server-side.
VITE_DROPBOX_CLIENT_ID=

# --- Google Workspace SSO (optional) ---
# Restrict signups to a single domain when using Google sign-in.
VITE_GOOGLE_WORKPLACE_DOMAIN=
